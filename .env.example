# ── Supabase ───────────────────────────────────────────────────────────────
# Proyecto → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# Solo servidor (crear pedidos, webhook). Nunca exponer con NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ── Sitio ──────────────────────────────────────────────────────────────────
# URL pública (sin barra final). En Vercel: https://prosuit.cl
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Mercado Pago (Checkout Pro) ────────────────────────────────────────────
# Credenciales de producción: https://www.mercadopago.cl/developers → Tus integraciones
# Si está vacío, la tienda vende solo por transferencia bancaria.
MP_ACCESS_TOKEN=
# Clave secreta del webhook (Tus integraciones → Webhooks). Opcional pero recomendado.
MP_WEBHOOK_SECRET=
# "true" para usar el checkout de pruebas (sandbox_init_point) con credenciales de test.
MP_SANDBOX=false

# ── Solo para `npm run sembrar` (no se despliegan) ─────────────────────────
ADMIN_EMAIL=
ADMIN_PASSWORD=
DEMO_EMAIL=demo@prosuit.cl
DEMO_PASSWORD=
